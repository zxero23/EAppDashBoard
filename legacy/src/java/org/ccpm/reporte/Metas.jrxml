	<parameter name="imagen" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT public.objetivos.leyenda AS objetivo,
	public.objetivos.organismo_id AS org_id,
	public.metas.leyenda AS leyenda,
	public.metas.descripcion AS descripcion,
	public.situacion.leyenda AS situacion,
	public.organismos.leyenda AS organismo,
	public.metas.fechafinal,
	public.metas.fechainicio
FROM public.metas
	INNER JOIN public.objetivos ON 
	 public.metas.objetivos_id = public.objetivos.id 
	INNER JOIN public.organismos ON 
	 public.objetivos.organismo_id = public.organismos.id 
	INNER JOIN public.situacion ON 
	 public.metas.situacion_id = public.situacion.id 
	 AND public.metas.situacion_id = public.situacion.id 
ORDER BY public.objetivos.organismo_id DESC]]>
	</queryString>
