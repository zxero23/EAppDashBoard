	<field name="org_id" class="java.lang.Long"/>
	<field name="leyenda" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="situacion" class="java.lang.String"/>
	<field name="organismo" class="java.lang.String"/>
