	<parameter name="imagen" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT public.objetivos.leyenda as leyenda,
	public.objetivos.descripcion as descripcion,
	public.organismos.leyenda as organismo,
	public.objetivos.organismo_id,
	public.situacion.leyenda as situacion
FROM public.objetivos
	INNER JOIN public.organismos ON 
	 public.objetivos.organismo_id = public.organismos.id 
	INNER JOIN public.situacion ON 
	 public.objetivos.situacion_id = public.situacion.id 
order BY public.objetivos.organismo_id ]]>
	</queryString>
