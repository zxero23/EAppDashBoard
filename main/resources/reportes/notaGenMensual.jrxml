	</parameter>
	<parameter name="mesa" class="java.lang.String"/>
	<parameter name="mesaExt" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT lista.dia as momento, count(listmin.minimo) as tot
FROM (
	select dia::date from generate_series($P{desde} ,  $P{hasta} , '1 day'::interval) as dia
) as lista
LEFT OUTER JOIN 

(select min(h.fecha) as minimo, n.id
from notas n
inner join notas_historialnotas nh
	on n.id=nh.nota_id	
inner join historialnotas h on h.id=nh.listahistorial_id
where   h.estadonota_id = 2
  AND h.fecha BETWEEN  $P{desde} AND  $P{hasta}  
  AND  (h.mesaorigen_id = $P{origen}  OR $P{origen} Is  null)
  AND (h.mesadestino_id = $P{destino}  OR $P{destino} Is null)
group by n.id) listmin 
  ON date_trunc('day',listmin.minimo)::timestamp::date = lista.dia   
GROUP BY  lista.dia
ORDER BY momento]]>
	</queryString>
	<field name="momento" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.label" value="momento"/>
	</field>
	<field name="tot" class="java.lang.Long">
