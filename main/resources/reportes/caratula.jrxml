	<parameter name="NombreOrganismo" class="java.lang.String">
		<defaultValueExpression><![CDATA["SECRETARIA DE ESTADO DE HACIENDA, FINANZAS OBRAS Y SERVICIOS PUBLICOS"]]></defaultValueExpression>
	</parameter>
	<parameter name="Organismo" class="java.lang.String">
		<defaultValueExpression><![CDATA["Dirección General del Centro de Cómputos de la Provincia"]]></defaultValueExpression>
	</parameter>
	<parameter name="parameter1" class="java.lang.Long"/>
	<parameter name="parameter2" class="java.lang.Long"/>
	<parameter name="parameter3" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select E.COD_ORGANISMO, E.NUM_CORRELATIVO, E.Anio, E.Cuerpo,
E.FECHA_CREACION as Fecha,E.Asunto, I.nombre as iniciador, E.ordenpago
from expedientes E inner join iniciador I on E.iniciador_id = I.id
where cod_organismo = $P!{parameter1} and
num_correlativo = $P!{parameter2} and
anio = $P!{parameter3}]]>
	</queryString>
