	<parameter name="usuario" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT notas.id AS id, 
notas.nronota AS nro, 
notas.referencia AS ref,
iniciador.nombre iniciador,
dest.nombre destino,
orig.nombre origen
FROM notas
  INNER JOIN iniciador ON notas.iniciador_id = iniciador.id
  INNER JOIN notas_historialnotas ON notas_historialnotas.nota_id = notas.id
  INNER JOIN historialnotas ON historialnotas.id = notas_historialnotas.listahistorial_id 
  INNER JOIN iniciador dest ON  historialnotas.mesadestino_id = dest.id 
  INNER JOIN iniciador orig ON historialnotas.mesaorigen_id = orig.id 
WHERE historialnotas.fecha BETWEEN  $P{desde} AND  $P{hasta}   
  AND  historialnotas.estadonota_id = $P{estado}
 AND  (historialnotas.mesaorigen_id = $P{origen}  OR $P{origen} Is  null)
  AND (historialnotas.mesadestino_id = $P{destino}  OR $P{destino} Is null)
    AND (historialnotas.usuario_id = $P{usuario}  OR $P{usuario}=0)
ORDER BY destino asc, historialnotas.fecha ASC, id ASC]]>
	</queryString>
