	<parameter name="mesaExt" class="java.lang.String"/>
	<parameter name="listado" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT expedientes.nroexp AS nroexp,
expedientes.orden_entrega AS ordenEntrega,
expedientes.pedido_fondo AS pedido,
asunto,
expedientes.fojas,
iniciador.nombre iniciador,
dest.nombre destino,
orig.nombre origen
FROM expedientes
  INNER JOIN iniciador ON expedientes.iniciador_id = iniciador.id
  INNER JOIN iniciador dest ON expedientes.mesadestino_id = dest.id
  INNER JOIN iniciador orig ON expedientes.mesaorigen_id = orig.id 
WHERE expedientes.cod_organismo :: character varying 
|| expedientes.num_correlativo :: character varying 
|| expedientes.anio :: character varying 
IN $P!{listado}
ORDER BY destino asc, expedientes.cod_organismo ASC,
 expedientes.anio ASC , expedientes.num_correlativo ASC]]>
	</queryString>
