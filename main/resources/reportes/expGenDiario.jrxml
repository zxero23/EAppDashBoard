	<parameter name="codigo" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT expedientes.cod_organismo||'-'||expedientes.num_correlativo||'/'||expedientes.anio AS nroexp,
asunto,
min(histexp.fecha) as momen,
iniciador.nombre inicia
FROM expedientes
  INNER JOIN iniciador ON expedientes.iniciador_id = iniciador.id
  INNER JOIN expedientes_histexp ON expedientes.anio =expedientes_histexp.anio 
     AND expedientes.num_correlativo = expedientes_histexp.num_correlativo 
     AND expedientes.cod_organismo = expedientes_histexp.cod_organismo
  INNER JOIN histexp ON histexp.id = expedientes_histexp.listhistoriales_id
WHERE histexp.fecha BETWEEN  $P{desde} AND  $P{hasta}
  AND  (histexp.mesaorigen_id =  $P{origen}   OR $P{origen}  Is  null)
  AND  (histexp.mesaorigen_id =  $P{destino}   OR $P{destino}  Is  null)
  AND  (expedientes.cod_organismo = $P{codigo})

 GROUP BY expedientes.cod_organismo,expedientes.num_correlativo,expedientes.anio, asunto, inicia
ORDER BY momen ASC, expedientes.cod_organismo, expedientes.num_correlativo  ASC]]>
	</queryString>
