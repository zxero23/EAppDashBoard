	<parameter name="mesaExt" class="java.lang.String"/>
	<parameter name="listado" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT notas.id AS id,
notas.nronota AS nro,
referencia,
fojas,
iniciador.nombre iniciador,
dest.nombre destino,
orig.nombre origen
FROM notas
  INNER JOIN iniciador ON notas.iniciador_id = iniciador.id
  INNER JOIN iniciador dest ON notas.mesadestino_id = dest.id
  INNER JOIN iniciador orig ON notas.mesaorigen_id = orig.id 
WHERE notas.id :: character varying  
IN $P!{listado}
ORDER BY destino asc, notas.id ASC]]>
	</queryString>
