	<queryString>
		<![CDATA[SELECT expedientes.nroexp AS nroexp,
histexp.fecha,
expedientes.orden_entrega AS ordenEntrega,
expedientes.orden_entrega_anio AS oeAnio,
expedientes.pedido_fondo AS pedido,
expedientes.pedido_fondo_anio AS pfAnio,
asunto,
histexp.fojas,
iniciador.nombre iniciador,
dest.nombre destino,
orig.nombre origen
FROM expedientes
  INNER JOIN iniciador ON expedientes.iniciador_id = iniciador.id
  INNER JOIN expedientes_histexp ON expedientes.anio =expedientes_histexp.anio 
     AND expedientes.num_correlativo = expedientes_histexp.num_correlativo 
     AND expedientes.cod_organismo = expedientes_histexp.cod_organismo
  INNER JOIN histexp ON histexp.id = expedientes_histexp.listhistoriales_id
  INNER JOIN iniciador dest ON histexp.mesadestino_id = dest.id
  INNER JOIN iniciador orig ON histexp.mesaorigen_id = orig.id 
WHERE histexp.fecha BETWEEN  $P{desde} AND  $P{hasta}   
  AND  histexp.estadohistorial_id = $P{estado}
 AND  (histexp.mesaorigen_id = $P{origen}  OR $P{origen} Is  null)
  AND (histexp.mesadestino_id = $P{destino}  OR $P{destino} Is null)
ORDER BY destino asc, histexp.fecha ASC, nroexp ASC]]>
	</queryString>
