	<parameter name="imagenHeader" class="java.lang.String"/>
	<parameter name="leyendaProvincia" class="java.lang.String"/>
	<parameter name="cod" class="java.lang.Long"/>
	<parameter name="correl" class="java.lang.Long"/>
	<parameter name="anio" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select
E.Asunto,
I.nombre as iniciador,
dest.nombre as destino,
orig.nombre as origen, 
histexp.fecha as fecha,
histexp.fojas as fojas,
estados.nombre as estado
from expedientes E
  inner join iniciador I on E.iniciador_id = I.id
  inner join expedientes_histexp 
     on expedientes_histexp.anio = E.anio
    and  expedientes_histexp.num_correlativo = E.num_correlativo
    and expedientes_histexp.cod_organismo = E.cod_organismo
  inner join histexp on expedientes_histexp.listhistoriales_id = histexp.id
  inner join iniciador dest on histexp.mesadestino_id = dest.id
  inner join iniciador orig on histexp.mesaorigen_id = orig.id
  inner join estados on estados.id =  histexp.estadohistorial_id 
where E.cod_organismo = $P{cod} and 
E.num_correlativo = $P{correl} and
E.anio = $P{anio}
order by fecha desc]]>
	</queryString>
	<field name="asunto" class="java.lang.String"/>
	<field name="iniciador" class="java.lang.String"/>
	<field name="destino" class="java.lang.String"/>
	<field name="origen" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Timestamp"/>
	<field name="fojas" class="java.lang.Integer"/>
	<field name="estado" class="java.lang.String"/>
